# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# API local. O front-end Next.js fica em http://localhost:3001.
PORT=3000

# URL pública desta API, usada pelo Better Auth para cookies e callbacks.
BETTER_AUTH_URL=http://localhost:3000

# Senha do usuário de teste local. Informe somente na execução do script
# `pnpm bootstrap:dev-user`, com NODE_ENV=development. Não grave o valor aqui.
# BOOTSTRAP_PMO_PASSWORD=

# Seed fictício. Informe somente na execução, com NODE_ENV=development.
# O banco precisa ser o PostgreSQL local gestao-projetos. Localhost sozinho não autoriza.
# DEMO_SEED_TARGET=gestao-projetos
# DEMO_SEED_PASSWORD=
# Limpeza, depois da prévia: DEMO_SEED_CLEAN_CONFIRM=APAGAR-CATALOGO-FICTICIO

# URL base do GLPI (ex.: https://glpi.exemplo.gov.br). Sem ela, os chamados aparecem só com o número, sem link.
# GLPI_BASE_URL=

# Testes de integração (`pnpm test:integration`). Usam SOMENTE um banco de testes explícito; nunca o DATABASE_URL acima.
# O banco precisa se chamar gp_test ou gp_test_<sufixo> (bancos como gestao-projetos, gp_iso_preview e postgres são
# recusados) e TEST_DATABASE_CONFIRM precisa repetir o nome exato do banco (uma sinalização genérica não autoriza).
# Sem essas variáveis os testes abortam antes de qualquer conexão ou escrita.
# TEST_DATABASE_URL=postgresql://usuario:senha@localhost:5432/gp_test
# TEST_DATABASE_CONFIRM=gp_test
