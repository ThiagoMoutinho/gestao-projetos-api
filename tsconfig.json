{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2024",
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
  },
  "include": ["src/**/*.ts"],
}
